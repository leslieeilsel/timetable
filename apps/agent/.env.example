HOST=127.0.0.1
PORT=8010
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LARAVEL_BASE_URL=http://127.0.0.1:8000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING_LEVEL=max
# Per model request; includes reasoning and answer tokens (384 * 1024).
DEEPSEEK_MAX_TOKENS=393216

# Single-instance Agent conversation database; keep on a private persistent volume.
AGENT_DATABASE_PATH=storage/chat.sqlite
